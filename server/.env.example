# GitHub fine-grained token:
#   Pull requests: read + WRITE (Approve, and the /azp run comment behind Queue/Requeue)
#   Metadata: read, Commit statuses: read, Checks: read (per-check pipeline status)
GITHUB_TOKEN=
PORT=3000

# Azure DevOps: Pipeline tab (stages + reruns) and, later, the Story tab.
# PAT needs Build: Read & execute (and Work Items: Read for the Story tab).
# If ADO_PAT is empty, the PERSONAL_ACCESS_TOKEN env var is used.
ADO_ORG=nbsdev
ADO_PROJECT=Services
ADO_PAT=
